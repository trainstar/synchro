{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synchro.dev/schemas/packaged-smoke-cell-v1.schema.json",
  "title": "Packaged smoke cell evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cell_id",
    "source_commit",
    "status",
    "artifact_hashes",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "cell_id": { "enum": [
      "SUP-PG-LINUX-X64-001", "SUP-IOS-MIN-001", "SUP-IOS-CURRENT-001",
      "SUP-RN-IOS-MIN-001", "SUP-RN-IOS-CURRENT-001", "SUP-ANDROID-MIN-001", "SUP-ANDROID-CURRENT-001",
      "SUP-RN-ANDROID-MIN-001", "SUP-RN-ANDROID-CURRENT-001"
    ] },
    "environment": { "type": "object" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "enum": ["passed", "failed"] },
    "artifact_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "operations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "terminal", "test_count"],
        "properties": {
          "name": { "enum": ["connect", "push", "pull", "kill", "resume"] },
          "status": { "enum": ["passed", "failed"] },
          "terminal": { "const": true },
          "test_count": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "failure": { "type": "string", "minLength": 1 },
    "process_lifecycle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_pid",
            "kill_signal",
            "resume_pid",
            "durable_pending_before_kill",
            "durable_pending_after_resume",
            "remote_value_applied",
            "server_resumed_write_verified"
          ],
          "properties": {
            "initial_pid": { "type": "integer", "minimum": 1 },
            "kill_signal": { "const": 9 },
            "resume_pid": { "type": "integer", "minimum": 1 },
            "durable_pending_before_kill": { "type": "integer", "minimum": 1 },
            "durable_pending_after_resume": { "const": 0 },
            "remote_value_applied": { "const": true },
            "server_resumed_write_verified": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "initial_pid",
            "kill_signal",
            "resume_pid",
            "push_digest",
            "replay_equal",
            "remote_value_applied",
            "server_resumed_write_verified"
          ],
          "properties": {
            "kind": { "const": "server" },
            "initial_pid": { "type": "integer", "minimum": 1 },
            "kill_signal": { "const": 9 },
            "resume_pid": { "type": "integer", "minimum": 1 },
            "push_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "replay_equal": { "const": true },
            "remote_value_applied": { "const": true },
            "server_resumed_write_verified": { "const": true }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": {
        "required": ["process_lifecycle", "environment"],
        "properties": { "artifact_hashes": { "minItems": 1 } }
      },
      "else": { "required": ["failure"] }
    }
  ],
  "oneOf": [
    { "properties": { "cell_id": { "const": "SUP-PG-LINUX-X64-001" }, "environment": { "$ref": "#/$defs/postgresqlEnvironment" } } },
    { "properties": { "cell_id": { "const": "SUP-IOS-MIN-001" }, "environment": { "$ref": "#/$defs/iosMinimumEnvironment" } } },
    { "properties": { "cell_id": { "const": "SUP-IOS-CURRENT-001" }, "environment": { "$ref": "#/$defs/iosEnvironment" } } },
    { "properties": { "cell_id": { "const": "SUP-RN-IOS-MIN-001" }, "environment": { "$ref": "#/$defs/reactNativeIosMinimumEnvironment" } } },
    { "properties": { "cell_id": { "const": "SUP-RN-IOS-CURRENT-001" }, "environment": { "$ref": "#/$defs/reactNativeIosEnvironment" } } },
    { "properties": { "cell_id": { "const": "SUP-ANDROID-MIN-001" }, "environment": { "$ref": "#/$defs/androidMinimumEnvironment" } } },
    { "properties": { "cell_id": { "const": "SUP-ANDROID-CURRENT-001" }, "environment": { "$ref": "#/$defs/androidEnvironment" } } },
    { "properties": { "cell_id": { "const": "SUP-RN-ANDROID-MIN-001" }, "environment": { "$ref": "#/$defs/reactNativeAndroidMinimumEnvironment" } } },
    { "properties": { "cell_id": { "const": "SUP-RN-ANDROID-CURRENT-001" }, "environment": { "$ref": "#/$defs/reactNativeAndroidEnvironment" } } }
  ],
  "$defs": {
    "appleVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?(?![\\s\\S])"
    },
    "positiveInteger": { "type": "string", "pattern": "^[1-9][0-9]*(?![\\s\\S])" },
    "emulatorVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "reactNativeVersion": { "type": "string", "pattern": "^0\\.83\\.(?:0|[1-9][0-9]*)(?![\\s\\S])" },
    "systemImage": {
      "type": "string",
      "pattern": "^system-images;android-[1-9][0-9]*(?:\\.0)?;google_apis;x86_64(?![\\s\\S])"
    },
    "postgresqlEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "os", "postgresql"],
      "properties": {
        "architecture": { "const": "x86_64" },
        "os": { "const": "ubuntu-24.04" },
        "postgresql": { "type": "string", "pattern": "^18\\.(?:0|[1-9][0-9]*)(?![\\s\\S])" }
      }
    },
    "iosMinimumEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["ios", "xcode"],
      "properties": {
        "ios": { "type": "string", "pattern": "^17\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?(?![\\s\\S])" },
        "xcode": { "$ref": "#/$defs/appleVersion" }
      }
    },
    "iosEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["ios", "xcode"],
      "properties": {
        "ios": { "$ref": "#/$defs/appleVersion" },
        "xcode": { "$ref": "#/$defs/appleVersion" }
      }
    },
    "reactNativeIosMinimumEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["ios", "xcode", "react_native"],
      "properties": {
        "ios": { "$ref": "#/$defs/appleVersion" },
        "xcode": { "$ref": "#/$defs/appleVersion" },
        "react_native": { "const": "0.82.1" }
      }
    },
    "reactNativeIosEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["ios", "xcode", "react_native"],
      "properties": {
        "ios": { "$ref": "#/$defs/appleVersion" },
        "xcode": { "$ref": "#/$defs/appleVersion" },
        "react_native": { "$ref": "#/$defs/reactNativeVersion" }
      }
    },
    "androidMinimumEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["android_api", "os", "system_image", "system_image_revision", "emulator_version", "emulator_build"],
      "properties": {
        "android_api": { "const": "24" },
        "os": { "const": "ubuntu-24.04" },
        "system_image": { "type": "string", "pattern": "^system-images;android-24(?:\\.0)?;google_apis;x86_64(?![\\s\\S])" },
        "system_image_revision": { "$ref": "#/$defs/positiveInteger" },
        "emulator_version": { "$ref": "#/$defs/emulatorVersion" },
        "emulator_build": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "androidEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["android_api", "os", "system_image", "system_image_revision", "emulator_version", "emulator_build"],
      "properties": {
        "android_api": { "$ref": "#/$defs/positiveInteger" },
        "os": { "const": "ubuntu-24.04" },
        "system_image": { "$ref": "#/$defs/systemImage" },
        "system_image_revision": { "$ref": "#/$defs/positiveInteger" },
        "emulator_version": { "$ref": "#/$defs/emulatorVersion" },
        "emulator_build": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "reactNativeAndroidMinimumEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["android_api", "os", "system_image", "system_image_revision", "emulator_version", "emulator_build", "react_native"],
      "properties": {
        "android_api": { "$ref": "#/$defs/positiveInteger" },
        "os": { "const": "ubuntu-24.04" },
        "system_image": { "$ref": "#/$defs/systemImage" },
        "system_image_revision": { "$ref": "#/$defs/positiveInteger" },
        "emulator_version": { "$ref": "#/$defs/emulatorVersion" },
        "emulator_build": { "$ref": "#/$defs/positiveInteger" },
        "react_native": { "const": "0.82.1" }
      }
    },
    "reactNativeAndroidEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["android_api", "os", "system_image", "system_image_revision", "emulator_version", "emulator_build", "react_native"],
      "properties": {
        "android_api": { "$ref": "#/$defs/positiveInteger" },
        "os": { "const": "ubuntu-24.04" },
        "system_image": { "$ref": "#/$defs/systemImage" },
        "system_image_revision": { "$ref": "#/$defs/positiveInteger" },
        "emulator_version": { "$ref": "#/$defs/emulatorVersion" },
        "emulator_build": { "$ref": "#/$defs/positiveInteger" },
        "react_native": { "$ref": "#/$defs/reactNativeVersion" }
      }
    }
  }
}
