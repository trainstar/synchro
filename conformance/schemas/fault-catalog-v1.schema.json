{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synchro.dev/conformance/schemas/fault-catalog-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "release", "faults", "controls"],
  "properties": {
    "$schema": { "const": "https://synchro.dev/conformance/schemas/fault-catalog-v1.schema.json" },
    "schema_version": { "const": 1 },
    "release": { "const": "0.3.0" },
    "faults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^FAULT-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
         "required": ["id", "fault_id", "subject_type", "requirement_ids", "normative_references", "injection", "expected_detection"],
        "properties": {
          "id": { "type": "string", "pattern": "^CTRL-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$" },
          "fault_id": { "type": "string", "pattern": "^FAULT-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$" },
          "subject_type": { "type": "string", "enum": ["mutant", "synthetic-fault", "known-defect", "source-mutant", "wire-fault", "state-fault", "process-fault", "infrastructure-fault", "artifact-tamper"] },
          "requirement_ids": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^SYNC-[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]{3}$" } },
          "normative_references": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "injection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism", "target", "operator", "parameters"],
            "properties": {
              "mechanism": { "type": "string", "enum": ["source-mutant", "wire-fault", "state-fault", "process-fault", "infrastructure-fault", "artifact-tamper"] },
              "target": { "type": "string", "minLength": 1 },
              "operator": { "type": "string", "enum": ["replace", "inject", "omit", "duplicate", "reorder", "replay", "misbind", "bypass", "truncate", "crash", "corrupt", "reroute", "expose", "delay"] },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scenario", "defect"],
                "properties": {
                  "scenario": { "type": "string", "minLength": 1 },
                  "defect": { "type": "string", "minLength": 1 },
                  "precondition": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "expected_detection": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
