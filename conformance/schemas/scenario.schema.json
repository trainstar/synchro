{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synchro.dev/conformance/schemas/scenario.schema.json",
  "title": "Synchro semantic conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "title",
    "requirement_ids",
    "proof_types",
    "steps",
    "assertions"
  ],
  "properties": {
    "$schema": { "const": "https://synchro.dev/conformance/schemas/scenario.schema.json" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/scenarioId" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirementId" }
    },
    "proof_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/proofType" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/step" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "negative_control": { "$ref": "#/$defs/negativeControl" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proof_types": { "contains": { "const": "negative-control" } }
        },
        "required": ["proof_types"]
      },
      "then": { "required": ["negative_control"] }
    }
  ],
  "$defs": {
    "scenarioId": {
      "type": "string",
      "pattern": "^SCN-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^SYNC-[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]{3}$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^STEP-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "assertionId": {
      "type": "string",
      "pattern": "^ASSERT-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "faultId": {
      "type": "string",
      "pattern": "^FAULT-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "proofType": {
      "type": "string",
      "enum": [
        "reference-model",
        "server-black-box",
        "native-e2e",
        "fault-injection",
        "negative-control"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "payload"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "payload": true
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "payload"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "payload": true
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "operation"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "phase": { "type": "string", "enum": ["setup", "exercise", "cleanup"] },
        "description": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/operation" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "predicate"],
      "properties": {
        "id": { "$ref": "#/$defs/assertionId" },
        "description": { "type": "string", "minLength": 1 },
        "predicate": { "$ref": "#/$defs/predicate" }
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fault_id", "detected_by"],
      "properties": {
        "fault_id": { "$ref": "#/$defs/faultId" },
        "detected_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/assertionId" }
        }
      }
    }
  }
}
