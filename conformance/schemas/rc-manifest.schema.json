{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synchro.dev/conformance/schemas/rc-manifest.schema.json",
  "title": "Synchro immutable release candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "candidate_id",
    "release_version",
    "source_commit",
    "created_at",
    "generator",
    "contract",
    "scenarios",
    "evidence",
    "resolved_support_cells",
    "artifacts",
    "attestations"
  ],
  "properties": {
    "$schema": { "const": "https://synchro.dev/conformance/schemas/rc-manifest.schema.json" },
    "schema_version": { "const": 1 },
    "candidate_id": { "$ref": "#/$defs/candidateId" },
    "release_version": { "const": "0.3.0" },
    "source_commit": { "$ref": "#/$defs/commitHash" },
    "created_at": { "type": "string", "format": "date-time" },
    "generator": { "$ref": "#/$defs/generator" },
    "contract": { "$ref": "#/$defs/contract" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scenarioReference" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "resolved_support_cells": {
      "type": "array",
      "minItems": 11,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resolvedSupportCell" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/attestation" }
    }
  },
  "$defs": {
    "candidateId": {
      "type": "string",
      "pattern": "^RC-0\\.3\\.0-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{7,64}$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^SCN-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EVD-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "supportCellId": {
      "type": "string",
      "pattern": "^SUP-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^ART-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "attestationId": {
      "type": "string",
      "pattern": "^ATTST-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "commitHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proofType": {
      "type": "string",
      "enum": [
        "reference-model",
        "server-black-box",
        "native-e2e",
        "fault-injection",
        "negative-control"
      ]
    },
    "exactVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[vV]?[0-9]+(?:\\.[0-9]+)*(?:\\+[0-9][0-9A-Za-z]*(?:[.-][0-9][0-9A-Za-z]*)*)?$",
      "allOf": [
        { "not": { "pattern": "^(?:[Cc]urrent-[Ss]table|[Cc]urrent|[Ll]atest)$" } },
        { "not": { "pattern": "(?:[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Nn][Ii][Gg][Hh][Tt][Ll][Yy]|[Ss][Nn][Aa][Pp][Ss][Hh][Oo][Tt]|[Hh][Ee][Aa][Dd]|[Mm][Aa][Ii][Nn]|[Mm][Aa][Ss][Tt][Ee][Rr]|[Dd][Ee][Vv]|[Cc][Aa][Nn][Aa][Rr][Yy]|[Nn][Ee][Xx][Tt]|[Tt][Rr][Uu][Nn][Kk]|[Pp][Rr][Ee][Vv][Ii][Ee][Ww]|[Ee][Dd][Gg][Ee]|[Rr][Oo][Ll][Ll][Ii][Nn][Gg])" } },
        { "not": { "pattern": "(?:^|\\.)(?:x|X)(?:\\.|$)" } },
        { "not": { "pattern": "[*<>=^~|,]" } },
        { "not": { "pattern": "\\+$" } },
        { "not": { "pattern": "\\s" } },
        { "not": { "pattern": "^[0-9]+(?:\\.[0-9]+)*-[0-9]+(?:\\.[0-9]+)*$" } }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "binary_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/exactVersion" },
        "binary_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contractFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "support_matrix"],
      "properties": {
        "requirements": {
          "allOf": [
            { "$ref": "#/$defs/contractFile" },
            { "properties": { "path": { "const": "conformance/requirements.json" } } }
          ]
        },
        "support_matrix": {
          "allOf": [
            { "$ref": "#/$defs/contractFile" },
            { "properties": { "path": { "const": "conformance/support-matrix.json" } } }
          ]
        }
      }
    },
    "scenarioReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "path", "sha256"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "proof_type", "path", "sha256"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/evidenceId" },
        "proof_type": { "$ref": "#/$defs/proofType" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resolvedDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/exactVersion" }
      }
    },
    "resolvedSupportCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_cell_id", "dimensions"],
      "properties": {
        "support_cell_id": { "$ref": "#/$defs/supportCellId" },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resolvedDimension" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/exactVersion" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/attestationId" },
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
