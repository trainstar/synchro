{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synchro.dev/conformance/schemas/support-matrix.schema.json",
  "title": "Synchro release support policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "release", "current_track_policy", "cells"],
  "properties": {
    "$schema": { "const": "./schemas/support-matrix.schema.json" },
    "schema_version": { "const": 1 },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "current_track_policy": { "$ref": "#/$defs/currentTrackPolicy" },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/supportCell" }
    }
  },
  "$defs": {
    "supportCellId": {
      "type": "string",
      "pattern": "^SUP-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "currentTrackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "resolve_at", "record_exact_versions_in"],
      "properties": {
        "selector": { "const": "current-stable" },
        "resolve_at": { "const": "release-candidate-start" },
        "record_exact_versions_in": { "const": "rc-manifest" }
      }
    },
    "exactSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "exact" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "minimumSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "minimum" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "seriesSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "series" },
        "value": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.x$" }
      }
    },
    "currentSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "current-stable" }
      }
    },
    "versionSelector": {
      "oneOf": [
        { "$ref": "#/$defs/exactSelector" },
        { "$ref": "#/$defs/minimumSelector" },
        { "$ref": "#/$defs/seriesSelector" },
        { "$ref": "#/$defs/currentSelector" }
      ]
    },
    "supportCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "platform", "policy"],
      "properties": {
        "id": { "$ref": "#/$defs/supportCellId" },
        "component": {
          "type": "string",
          "enum": [
            "postgresql-server",
            "swift-client",
            "kotlin-client",
            "react-native-client"
          ]
        },
        "platform": {
          "type": "string",
          "enum": ["postgresql", "ios", "macos", "android"]
        },
        "platform_version": { "$ref": "#/$defs/versionSelector" },
        "runtime_version": { "$ref": "#/$defs/versionSelector" },
        "policy": { "type": "string", "enum": ["required", "excluded"] },
        "note": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["platform_version"] },
        { "required": ["runtime_version"] }
      ],
      "allOf": [
        {
          "if": {
            "properties": { "component": { "const": "react-native-client" } },
            "required": ["component"]
          },
          "then": { "required": ["platform_version", "runtime_version"] }
        }
      ]
    }
  }
}
