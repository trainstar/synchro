                 let failure_class = failure.class;
                 if let Err(error) = persist_poison(failure) {
                     log!("synchro WAL poison persistence failed for {failure_class}: {error}");
+                } else {
+                    // Mutant: skip persisted poison by acknowledging the flushed WAL suffix.
+                    let slot = decoder_state.identity.slot_name.clone();
+                    if run_replication_transaction(worker_role_oid, || {
+                        Spi::connect_mut(|client| {
+                            client
+                                .select(
+                                    "SELECT pg_catalog.pg_replication_slot_advance($1, pg_catalog.pg_current_wal_flush_lsn())",
+                                    None,
+                                    &[slot.as_str().into()],
+                                )
+                                .map(|_| ())
+                                .map_err(|_| ())
+                        })
+                    }).is_err() {
+                        log!("synchro WAL poison skip failed");
+                    }
                 }
                 blocked = true;
             }
