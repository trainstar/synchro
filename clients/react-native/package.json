{
  "name": "@trainstar/synchro-react-native",
  "version": "0.4.0-rc.4",
  "description": "React Native bridge for Synchro sync SDK",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./inspection": {
      "source": "./src/inspection.ts",
      "types": "./lib/typescript/src/inspection.d.ts",
      "default": "./lib/module/inspection.js"
    },
    "./tooling-patches/apply": "./tooling-patches/apply.cjs",
    "./tooling-patches/cli-config-android-20.2.0.patch": "./tooling-patches/cli-config-android-20.2.0.patch",
    "./tooling-patches/cli-clean-20.2.0.patch": "./tooling-patches/cli-clean-20.2.0.patch",
    "./tooling-patches/react-native-builder-bob-0.40.18.patch": "./tooling-patches/react-native-builder-bob-0.40.18.patch",
    "./tooling-patches/react-native-gradle-plugin-0.82.1-kotlin-2.4.21.patch": "./tooling-patches/react-native-gradle-plugin-0.82.1-kotlin-2.4.21.patch",
    "./tooling-patches/react-native-gradle-plugin-0.88.0-kotlin-2.4.21.patch": "./tooling-patches/react-native-gradle-plugin-0.88.0-kotlin-2.4.21.patch",
    "./tooling-patches/stream-json-1.9.1.patch": "./tooling-patches/stream-json-1.9.1.patch",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "ios-test-host",
    "ios-tests",
    "tooling-patches",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @trainstar/synchro-react-native-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "pack:dry-run": "npm pack --dry-run",
    "test:unit": "jest --runInBand --watchman=false",
    "typecheck": "tsc",
    "lint": "eslint src/ __tests__/ example/e2e/ example/src/",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "synchro",
    "sync",
    "offline-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trainstar/synchro.git"
  },
  "author": "Trainstar <dev@trainstar.com> (https://trainstar.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trainstar/synchro/issues"
  },
  "homepage": "https://github.com/trainstar/synchro#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.40.18",
    "react-test-renderer": "19.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=19.1.1 <20.0.0",
    "react-native": ">=0.82.1 <0.89.0"
  },
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "@react-native-community/cli-config-android@npm:20.2.0": "patch:@react-native-community/cli-config-android@npm%3A20.2.0#./tooling-patches/cli-config-android-20.2.0.patch",
    "@react-native-community/cli-clean@npm:20.2.0": "patch:@react-native-community/cli-clean@npm%3A20.2.0#./tooling-patches/cli-clean-20.2.0.patch",
    "@react-native/gradle-plugin@npm:0.88.0": "patch:@react-native/gradle-plugin@npm%3A0.88.0#./tooling-patches/react-native-gradle-plugin-0.88.0-kotlin-2.4.21.patch",
    "react-native-builder-bob@npm:^0.40.18": "patch:react-native-builder-bob@npm%3A0.40.18#./tooling-patches/react-native-builder-bob-0.40.18.patch",
    "stream-json@npm:^1.7.4": "patch:stream-json@npm%3A1.9.1#./tooling-patches/stream-json-1.9.1.patch",
    "stream-json@npm:^1.7.5": "patch:stream-json@npm%3A1.9.1#./tooling-patches/stream-json-1.9.1.patch"
  },
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "SynchroModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.trainstar.synchro.rn"
    },
    "ios": {
      "modulesProvider": {
        "SynchroModule": "SynchroModule"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@trainstar/synchro-react-native/inspection$": "<rootDir>/src/inspection",
      "^react-native$": "<rootDir>/__tests__/__mocks__/react-native"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/example/e2e",
      "<rootDir>/node_modules",
      "<rootDir>/__tests__/__mocks__"
    ]
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "jest"
    ],
    "version": "0.57.2"
  }
}
