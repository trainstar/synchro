ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '17.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SynchroReactNativeExample' do
  # Local path to the Synchro podspec at the repository root
  pod 'Synchro', :path => '../../../..'
  # Use the GRDB Git distribution at the tested release tag.
  pod 'GRDB.swift', :git => 'https://github.com/groue/GRDB.swift.git', :tag => 'v7.8.0'
  # Autolinking skips a pod that this target already declares.
  pod 'SynchroReactNative', :path => '../..', :testspecs => ['Tests']

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    targets = installer.pods_project.targets.to_h { |target| [target.name, target] }
    host = targets['SynchroReactNative-TestHost']
    tests = targets['SynchroReactNative-Unit-Tests']
    raise Pod::Informative, 'SynchroReactNative test host target is missing' unless host
    raise Pod::Informative, 'SynchroReactNative unit test target is missing' unless tests

    tests.build_configurations.each do |build_configuration|
      path = build_configuration.base_configuration_reference&.real_path
      raise Pod::Informative, 'SynchroReactNative unit test xcconfig is missing' unless path&.file?

      settings = Xcodeproj::Config.new(path)
      unless settings.other_linker_flags[:libraries].include?('SynchroReactNative')
        raise Pod::Informative, 'SynchroReactNative unit tests must link the production module'
      end
    end

    host.build_configurations.each do |build_configuration|
      path = build_configuration.base_configuration_reference&.real_path
      raise Pod::Informative, 'SynchroReactNative test host xcconfig is missing' unless path&.file?

      settings = Xcodeproj::Config.new(path)
      settings.other_linker_flags[:libraries].delete('SynchroReactNative')
      settings.save_as(path)
    end
  end
end
